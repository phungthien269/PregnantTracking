# =============================================================================
# Mẹ & Bé — biến môi trường cho web app (Next.js)
# Copy file này thành `.env.local` rồi điền key:
#   cp apps/web/.env.example apps/web/.env.local
#
# Quy tắc an toàn:
# - Chỉ biến có tiền tố `NEXT_PUBLIC_` được phép xuất hiện ở trình duyệt (client).
# - Mọi biến KHÁC (service role, OpenRouter, Inngest) là SERVER-SIDE — KHÔNG thêm
#   tiền tố `NEXT_PUBLIC_`, không được lộ ra client bundle.
# - File `.env.local` đã nằm trong `.gitignore` — KHÔNG commit key thật.
#
# Cách kiểm tra nhanh sau khi điền: `node scripts/check-env.ts`
# =============================================================================

# ---- Supabase (backend thật) ------------------------------------------------
# Có đủ 2 biến này → app bỏ chế độ demo (mock), dùng backend thật qua DataApi.
# Lấy từ: Supabase Dashboard → Project Settings → API (Project URL / anon public key).
# Nếu để trống cả 2 → app chạy chế độ demo (dữ liệu mock tiếng Việt), không cần backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — QUYỀN CAO NHẤT, bypass RLS. CHỈ dùng server-side (seed,
# storage, tác vụ admin). App hiện KHÔNG tự đọc biến này; cần khi chạy seed hoặc
# các tác vụ server tự viết sau. Lấy từ: Dashboard → Settings → API → service_role.
# KHÔNG đặt tên `NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY` (sẽ lộ key ra client!).
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenRouter (AI: chat, insight, phân tích triệu chứng, quiz, OCR) ------
# Đọc server-side ở `lib/ai/client.ts`. Không có key → AI chạy mock/fallback,
# app không lỗi. Key lấy từ openrouter.ai → Keys.
OPENROUTER_API_KEY=

# ---- Thư viện AI (embedding / suggest-stage / quiz-gen) — TÙY CHỌN ---------
# Base URL của microservice AI riêng cho pipeline thư viện (đọc ở lib/library/ai.ts).
# Thiếu → import PDF/EPUB/URL chạy fallback local (full-text, stage từ khóa, quiz cơ bản).
# Khế ước: POST {BASE}/embed, {BASE}/suggest-stage, {BASE}/quiz-gen.
# LIBRARY_AI_BASE_URL=

# ---- Inngest (notification / reminder) --------------------------------------
# Đọc ở `inngest/client.ts`. Có đủ cả 2 → gửi event thật tới Inngest;
# thiếu → notification chạy mock (hộp thư trong ứng dụng + log).
# Lấy từ: Inngest Cloud → Environment → SDK URL (đặt vào INGEST_URL) + Signing key
# (đặt vào INGEST_KEY). URL ví dụ: https://<env-id>.inngest.ai
INGEST_KEY=
INGEST_URL=

# ---- Email thật (kênh email của notification) --------------------------------
# Tạo key tại resend.com → API Keys. Thiếu key → email fallback về hộp thư in-app.
# RESEND_FROM tuỳ chọn (mặc định onboarding@resend.dev — chỉ gửi được tới email
# owner tài khoản Resend; gửi tới người dùng khác cần verify domain).
RESEND_API_KEY=
RESEND_FROM=
